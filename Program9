#include <iostream>
using namespace std;

class Shape
{
    float radius, length, width;

public:
    Shape(float r, float l, float w)
    {
        radius = r;
        length = l;
        width = w;
    }

    void circle()
    {
        cout << "Perimeter of Circle: "
             << 2 * 3.14 * radius << endl;
    }

    void rectangle()
    {
        cout << "Perimeter of Rectangle: "
             << 2 * (length + width) << endl;
    }

    ~Shape()
    {
        cout << "Destructor called.";
    }
};

int main()
{
    Shape s(5, 10, 6);

    s.circle();
    s.rectangle();

    return 0;
}